generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Cliente {
  id             String    @id @default(uuid()) @db.Uuid
  nome           String
  cpf            String?   @unique
  telefone       String
  whatsapp       String?
  email          String?
  dataNascimento DateTime? @map("data_nascimento") @db.Date
  endereco       String?
  categoria      String    @default("regular")
  totalGasto     Decimal   @default(0) @map("total_gasto") @db.Decimal(10, 2)
  totalPedidos   Int       @default(0) @map("total_pedidos")
  observacoes    String?
  ativo          Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")

  pedidos      Pedido[]
  notificacoes Notificacao[]

  @@index([telefone])
  @@index([cpf])
  @@index([nome])
  @@map("clientes")
}

model Pedido {
  id                  String    @id @default(uuid()) @db.Uuid
  protocolo           String    @unique
  clienteId           String    @map("cliente_id") @db.Uuid
  status              String    @default("recebido")
  valorTotal          Decimal   @default(0) @map("valor_total") @db.Decimal(10, 2)
  desconto            Decimal   @default(0) @db.Decimal(10, 2)
  valorFinal          Decimal   @default(0) @map("valor_final") @db.Decimal(10, 2)
  observacoes         String?
  dataPrevisaoEntrega DateTime? @map("data_previsao_entrega")
  dataEntrega         DateTime? @map("data_entrega")
  formaPagamento      String?   @map("forma_pagamento")
  pago                Boolean   @default(false)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")

  cliente      Cliente       @relation(fields: [clienteId], references: [id])
  itens        PedidoItem[]
  notificacoes Notificacao[]

  @@index([protocolo])
  @@index([clienteId])
  @@index([status])
  @@index([createdAt])
  @@map("pedidos")
}

model PedidoItem {
  id            String  @id @default(uuid()) @db.Uuid
  pedidoId      String  @map("pedido_id") @db.Uuid
  descricao     String
  tipoServico   String? @map("tipo_servico")
  quantidade    Int     @default(1)
  precoUnitario Decimal @map("preco_unitario") @db.Decimal(10, 2)
  precoTotal    Decimal @map("preco_total") @db.Decimal(10, 2)
  cor           String?
  defeitos      String?

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@map("pedidos_itens")
}

model Notificacao {
  id            String   @id @default(uuid()) @db.Uuid
  clienteId     String?  @map("cliente_id") @db.Uuid
  pedidoId      String?  @map("pedido_id") @db.Uuid
  tipo          String?
  canal         String   @default("email")
  mensagem      String?
  status        String?
  erroDescricao String?  @map("erro_descricao")
  enviadoEm     DateTime @default(now()) @map("enviado_em")

  cliente Cliente? @relation(fields: [clienteId], references: [id])
  pedido  Pedido?  @relation(fields: [pedidoId], references: [id])

  @@map("notificacoes_enviadas")
}
