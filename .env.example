# =============================================================
# pulse - Variaveis de Ambiente
# =============================================================
# Copie este arquivo para .env.local e preencha com suas credenciais:
#   cp .env.example .env.local
#
# Valide sua configuracao com: npm run validate
# =============================================================

# Database (obrigatorio)
DATABASE_URL="postgresql://user:password@localhost:5432/pulso?schema=public"

# NextAuth (obrigatorio)
AUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# App URL (obrigatorio)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (opcional - login social)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# OpenAI (opcional - coach IA e relatorios)
OPENAI_API_KEY="sk-your-openai-api-key"

# Asaas - Pagamentos (opcional)
ASAAS_API_KEY="your-asaas-api-key"
ASAAS_WEBHOOK_TOKEN="your-webhook-verification-token"
ASAAS_SANDBOX="true"

# =============================================================
# Resend - Email
# =============================================================
# Obtenha sua API key em: https://resend.com/api-keys
RESEND_API_KEY="re_your-resend-api-key"

# IMPORTANTE: Sobre o endereco de envio (EMAIL_FROM)
#
# SANDBOX (desenvolvimento):
#   O endereco "onboarding@resend.dev" e um sandbox do Resend.
#   Ele so consegue enviar emails para o email cadastrado na sua conta Resend.
#   Use para testes locais durante o desenvolvimento.
#
# PRODUCAO (qualquer destinatario):
#   Para enviar emails para qualquer usuario, voce precisa verificar seu dominio:
#   1. Acesse https://resend.com/domains
#   2. Clique "Add Domain" e insira seu dominio (ex: pulseprodutividade.com.br)
#   3. O Resend mostrara registros DNS (MX, SPF/TXT, DKIM/TXT)
#   4. Adicione esses registros no seu provedor DNS:
#      - Vercel: Projeto > Settings > Domains > DNS Records
#      - Cloudflare: DNS > Records > Add Record
#   5. Volte ao Resend e clique "Verify" (geralmente leva poucos minutos)
#   6. Atualize EMAIL_FROM abaixo para usar seu dominio verificado
#   7. Faca redeploy no Vercel
#
# Sandbox (desenvolvimento):
EMAIL_FROM="pulse <onboarding@resend.dev>"
# Producao (apos verificar dominio):
# EMAIL_FROM="pulse <noreply@pulseprodutividade.com.br>"
