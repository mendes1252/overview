# =============================================================
# Steddi — Variáveis de Ambiente
# =============================================================
# Copie este arquivo para .env.local e preencha com suas credenciais:
#   cp .env.example .env.local
# =============================================================

# =============================================================
# Supabase (obrigatório)
# Obtenha em: https://app.supabase.com → Projeto → Settings → API
# =============================================================
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# =============================================================
# App URL (obrigatório)
# =============================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# =============================================================
# Asaas — Pagamentos (Sprint 4)
# Sandbox: https://sandbox.asaas.com
# Produção: https://api.asaas.com
# =============================================================
ASAAS_API_KEY="your-asaas-api-key"
ASAAS_WEBHOOK_SECRET="your-webhook-secret"
ASAAS_ENVIRONMENT="sandbox"

# =============================================================
# Resend — Email Transacional (Sprint 2)
# Obtenha em: https://resend.com/api-keys
# =============================================================
RESEND_API_KEY="re_your-resend-api-key"
EMAIL_FROM="Steddi <noreply@steddi.io>"

# =============================================================
# Anthropic — Claude API para Relatórios IA (Sprint 6)
# =============================================================
ANTHROPIC_API_KEY="sk-ant-your-anthropic-key"

# =============================================================
# Cron Jobs
# =============================================================
CRON_SECRET="your-cron-secret-here"
